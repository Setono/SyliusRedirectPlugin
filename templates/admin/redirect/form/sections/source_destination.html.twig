<div class="col-12">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">{{ 'setono_sylius_redirect.ui.source_and_destination'|trans }}</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6">
                    {{ form_row(hookable_metadata.context.form.source) }}
                    <div
                        data-setono-sylius-redirect-source-duplicate-warning
                        data-check-url="{{ path('setono_sylius_redirect_admin_ajax_redirect_check_source') }}"
                        data-exclude-id="{{ hookable_metadata.context.resource.id|default('') }}"
                        data-message="{{ 'setono_sylius_redirect.ui.source_already_exists'|trans }}"
                        data-link-label="{{ 'setono_sylius_redirect.ui.view_existing_redirect'|trans }}"
                    ></div>
                </div>
                <div class="col-12 col-md-6">
                    {{ form_row(hookable_metadata.context.form.destination) }}
                    <div
                        data-setono-sylius-redirect-destination-hostname-warning
                        data-channel-hostnames="{{ setono_sylius_redirect_enabled_channel_hostnames()|json_encode|e('html_attr') }}"
                        data-message="{{ 'setono_sylius_redirect.ui.destination_matches_channel_hint'|trans }}"
                    ></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(() => {
    document.querySelectorAll('[data-setono-sylius-redirect-destination-hostname-warning]').forEach((wrapper) => {
        const hostnames = JSON.parse(wrapper.dataset.channelHostnames || '[]');
        if (hostnames.length === 0) {
            return;
        }
        const input = wrapper.parentElement.querySelector('input[type="text"]');
        if (input === null) {
            return;
        }
        const check = () => {
            wrapper.innerHTML = '';
            const value = input.value.trim();
            if (value === '') {
                return;
            }
            let url;
            try {
                url = new URL(value);
            } catch (e) {
                return;
            }
            if (hostnames.includes(url.hostname) || hostnames.includes(url.host)) {
                const alert = document.createElement('div');
                alert.className = 'alert alert-info mt-2';
                alert.textContent = wrapper.dataset.message;
                wrapper.appendChild(alert);
            }
        };
        input.addEventListener('blur', check);
    });

    document.querySelectorAll('[data-setono-sylius-redirect-source-duplicate-warning]').forEach((wrapper) => {
        const input = wrapper.parentElement.querySelector('input[type="text"]');
        if (input === null) {
            return;
        }
        const checkUrl = wrapper.dataset.checkUrl;
        const excludeId = wrapper.dataset.excludeId || '';
        const message = wrapper.dataset.message;
        const linkLabel = wrapper.dataset.linkLabel;
        const check = async () => {
            wrapper.innerHTML = '';
            const value = input.value.trim();
            if (value === '') {
                return;
            }
            const url = new URL(checkUrl, window.location.origin);
            url.searchParams.set('source', value);
            if (excludeId !== '') {
                url.searchParams.set('excludeId', excludeId);
            }
            let payload;
            try {
                const response = await fetch(url.toString(), {
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });
                if (!response.ok) {
                    return;
                }
                payload = await response.json();
            } catch (e) {
                return;
            }
            if (!payload.exists) {
                return;
            }
            const alert = document.createElement('div');
            alert.className = 'alert alert-warning mt-2 d-flex justify-content-between align-items-center gap-2';
            const text = document.createElement('span');
            text.textContent = message;
            const link = document.createElement('a');
            link.href = payload.editUrl;
            link.className = 'btn btn-sm btn-outline-warning';
            link.textContent = linkLabel;
            link.target = '_blank';
            link.rel = 'noopener';
            alert.appendChild(text);
            alert.appendChild(link);
            wrapper.appendChild(alert);
        };
        input.addEventListener('blur', check);
    });
})();
</script>
