<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_redirect.url_resolver.automatic_redirect.composite"
                 class="Setono\SyliusRedirectPlugin\UrlResolver\AutomaticRedirectUrlResolver"/>
        <service id="Setono\SyliusRedirectPlugin\UrlResolver\AutomaticRedirectUrlResolverInterface"
                 alias="setono_sylius_redirect.url_resolver.automatic_redirect.composite"/>

        <service id="setono_sylius_redirect.url_resolver.automatic_redirect.product"
                 class="Setono\SyliusRedirectPlugin\UrlResolver\ProductAutomaticRedirectUrlResolver">
            <argument type="service" id="router"/>
            <tag name="setono_sylius_redirect.automatic_redirect_url_resolver"/>
        </service>

        <service id="setono_sylius_redirect.url_resolver.automatic_redirect.taxon"
                 class="Setono\SyliusRedirectPlugin\UrlResolver\TaxonAutomaticRedirectUrlResolver">
            <argument type="service" id="router"/>
            <tag name="setono_sylius_redirect.automatic_redirect_url_resolver"/>
        </service>
    </services>
</container>
